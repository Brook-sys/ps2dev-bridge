# Required: API key that clients must send in the X-API-Key header
PS2BRIDGE_API_KEY=change-me

# Required: IP address of the PS2 console (running ps2link) on your LAN
PS2_HOST=192.168.0.10

# Optional: ps2link request port used by the bridge's pre-flight probe
# (TCP 18193 is the ps2link default; override only for custom setups)
# PS2BRIDGE_PS2LINK_PORT=18193

# Optional: reset tuning. PS2BRIDGE_RESET_DOWN_WAIT is how long the bridge
# watches for ps2link to go down after `ps2client reset` (the console
# rebooting); PS2BRIDGE_RESET_UP_WAIT is how long it then waits for ps2link
# to answer again before reporting an honest failure.
# PS2BRIDGE_RESET_DOWN_WAIT=10
# PS2BRIDGE_RESET_UP_WAIT=30
